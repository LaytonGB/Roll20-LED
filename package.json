{
  "name": "locs",
  "version": "1.0.0",
  "description": "An API for Roll20.net to enable the automatic caching of tokens, their positions, and specific token attributes.",
  "main": "locs.js",
  "scripts": {
    "build": "npm run create-target-file-without-exports && npm run build-generated-target-file && npm run delete-generated-target-file",
    "create-target-file-without-exports": "sed -E \"s/export\\s+//g\" ./src/index.ts > ./src/target.ts",
    "build-generated-target-file": "tsc ./src/target.ts --outFile ./locs.js --target es2019 --module amd",
    "delete-generated-target-file": "rm ./src/target.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/LaytonGB/token-state-api.git"
  },
  "author": "Layton Burchell",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/LaytonGB/token-state-api/issues"
  },
  "homepage": "https://gitlab.com/LaytonGB/token-state-api#readme",
  "devDependencies": {
    "@types/roll20": "github:LaytonGB/types-roll20",
    "typescript": "^5.1.6"
  }
}
